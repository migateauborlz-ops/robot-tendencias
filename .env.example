# Apify Settings
APIFY_API_TOKEN=pon_tu_token_aqui
# IDs de los Scrapers (Actors)
APIFY_ACTOR_TIKTOK_VIDEOS=clockworks/tiktok-scraper
APIFY_ACTOR_TIKTOK_COMMENTS=clockworks/tiktok-comments-scraper
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper

MAX_SCRAPE_ITEMS=100

# Database Settings
# Ruta relativa a la raiz del proyecto. Con ../ la base quedaba
# fuera del repositorio y fuera del alcance de .gitignore.
DB_PATH=sqlite:///data/trends.db
    

# Ventana de recencia aplicada a las publicaciones ingeridas.
# 30 dias, no 7: con 7 las publicaciones aun no acumulan comentarios
# (mediana de 16 likes y cero comentarios en la muestra del 2026-08-20).
INGESTION_WINDOW_DAYS=30

# Geografia de Google Trends.
# TRENDS_GEO es el mercado donde se DETECTA la tendencia. Vacio = mundial.
# Se usa mundial por defecto porque el corpus viene de hashtags globales y esos
# productos casi no registran busquedas en Colombia todavia: ese rezago es
# justamente la oportunidad comercial.
# TRENDS_GEO_LOCAL es el mercado objetivo contra el que se mide el rezago.
# Ponga TRENDS_COMPARE_GEOS=0 para validar solo en el mercado de deteccion.
TRENDS_GEO=
TRENDS_GEO_LOCAL=CO
TRENDS_COMPARE_GEOS=1
TRENDS_TIMEFRAME=today 1-m
